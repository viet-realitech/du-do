{
  "name": "du-do",
  "private": true,
  "version": "2.0.0",
  "description": "Dư Đồ — bản đồ Việt Nam 1858 – nay, trò chơi lịch sử",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test",
    "checks": "npm run -s scenes && npm run -s choices && npm run -s endings:filter && npm run -s voice:check",
    "choices": "tsx scripts/lock-choices.ts",
    "choices:lock": "tsx scripts/lock-choices.ts --write",
    "endings:check": "tsx scripts/check-endings.ts",
    "endings:filter": "tsx scripts/check-endings.ts --filter",
    "size": "tsx scripts/check-size.ts",
    "size:update": "tsx scripts/check-size.ts --update",
    "perf:budget": "PERF_UPDATE=1 playwright test e2e/perf.spec.ts --workers=1",
    "geo": "node scripts/build-geo.mjs",
    "icons": "node scripts/build-icons.mjs",
    "music": "node scripts/build-music.mjs",
    "voice": "node scripts/build-voice.mjs && tsx scripts/voice-script.ts && tsx scripts/check-voice.ts",
    "voice:script": "tsx scripts/voice-script.ts",
    "voice:tts": "python3 scripts/tts/generate.py",
    "voice:check": "tsx scripts/check-voice.ts",
    "scenes": "tsx scripts/check-scenes.ts && tsx scripts/sim-loyal.ts --strict",
    "endings": "tsx scripts/sim-endings.ts --strict --out src/data/endings-rarity.json"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
